# Development template only. Run make configure to generate a private local .env.
APP_NAME=DistrictIQ Hawaii
APP_ENV=development
DEBUG=false

# Server-side database settings. Generated locally; never commit real credentials.
POSTGRES_DB=districtiq
POSTGRES_USER=districtiq
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://districtiq:CHANGE_ME@localhost:5432/districtiq

# Private server-side API keys. Optional for the cached-data dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
CENSUS_API_KEY=

HOUSE_DISTRICT_LAYER_URL=https://geodata.hawaii.gov/arcgis/rest/services/AdminBnd/MapServer/33
SENATE_DISTRICT_LAYER_URL=https://geodata.hawaii.gov/arcgis/rest/services/AdminBnd/MapServer/34
GEOPORTAL_BASE_URL=https://geoportal.hawaii.gov
GEOPORTAL_SEARCH_API=https://geoportal.hawaii.gov/api/search/v1
GEOPORTAL_DCAT_URL=https://geoportal.hawaii.gov/api/feed/dcat-us/1.1.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public browser configuration only. NEXT_PUBLIC_* values are visible to visitors.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Only use a browser-scoped, origin-restricted ArcGIS key if needed; public layers work without one.
NEXT_PUBLIC_ARCGIS_API_KEY=
